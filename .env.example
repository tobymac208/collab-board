# Copy to .env and adjust as needed. Values below match docker-compose.yml (local dev only).
DATABASE_URL=postgres://collab:collab@localhost:5432/collab

# WebSocket server
PORT=4000
# Comma-separated list of origins allowed to open WebSocket connections and call the auth API
ALLOWED_ORIGINS=http://localhost:3000
# Mark the session cookie Secure (HTTPS only). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Web app (exposed to the browser)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Must be same-site with the web app (same registrable domain) so the session cookie is sent
NEXT_PUBLIC_API_URL=http://localhost:4000
